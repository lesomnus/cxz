{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    ".storybook",
    "src",
    "gen",
    "vite.config.ts",
    "playwright.config.ts",
    "e2e",
    "vite.sandbox.config.ts",
    "playwright.sandbox.config.ts",
    "sandbox-e2e"
  ]
}
