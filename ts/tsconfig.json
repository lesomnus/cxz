{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "customConditions": ["nox-source"]
  },
  "include": [
    ".storybook",
    "src",
    "gen",
    "vite.config.ts",
    "playwright.config.ts",
    "e2e",
    "vite.sandbox.config.ts",
    "playwright.sandbox.config.ts",
    "sandbox-e2e",
    "playwright.storybook.config.ts",
    "storybook-e2e",
    "playwright.performance.config.ts",
    "performance-e2e",
    "test-support/transcript-performance.tsx",
    "packages/nox/src",
    ".storybook-ui",
    "playwright.ui.config.ts",
    "ui-e2e",
    "nox-e2e",
    "playwright.nox.config.ts",
    "vite.nox-development.config.ts",
    "test-support/nox-development.tsx"
  ]
}
