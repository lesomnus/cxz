{
  "name": "@lesomnus/cxz-ui",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/style.css",
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "development": "./src/editor/index.ts",
      "import": "./dist/editor.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/finalize-build.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "monaco-editor": "^0.55.0"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": true
    }
  }
}
